name: Utwórz res

# Jednorazowo tworzy komplet plików res (motyw, teksty, reguły backupu, ikona AiXE)
# w AiXE-browser-project/app/src/main/res i od razu uruchamia budowanie APK.

on:
  workflow_dispatch:

permissions:
  contents: write
  actions: write

jobs:
  create-res:
    runs-on: ubuntu-latest
    steps:
      - name: Pobierz repozytorium
        uses: actions/checkout@v4

      - name: Utwórz folder res
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -e
          R=AiXE-browser-project/app/src/main/res
          mkdir -p "$R/drawable" "$R/mipmap-anydpi-v26" "$R/values" "$R/xml"
          cat > "$R/values/values.xml" << 'EOF_RES'
          <?xml version="1.0" encoding="utf-8"?>
          <resources>
              <string name="app_name">AiXE browser</string>

              <!-- Motyw systemowy bez paska akcji; cały wygląd rysuje Jetpack Compose. -->
              <style name="Theme.AiXEBrowser" parent="android:Theme.Material.Light.NoActionBar" />
          </resources>
          EOF_RES
          cat > "$R/xml/backup_rules.xml" << 'EOF_RES'
          <?xml version="1.0" encoding="utf-8"?>
          <full-backup-content>
              <!-- Domyślnie: kopia zapasowa obejmuje wszystkie dane aplikacji. -->
          </full-backup-content>
          EOF_RES
          cat > "$R/xml/data_extraction_rules.xml" << 'EOF_RES'
          <?xml version="1.0" encoding="utf-8"?>
          <data-extraction-rules>
              <cloud-backup>
                  <!-- Domyślnie: kopia w chmurze obejmuje wszystkie dane aplikacji. -->
              </cloud-backup>
              <device-transfer>
                  <!-- Domyślnie: przenoszenie na nowe urządzenie obejmuje wszystkie dane aplikacji. -->
              </device-transfer>
          </data-extraction-rules>
          EOF_RES
          cat > "$R/mipmap-anydpi-v26/ic_launcher.xml" << 'EOF_RES'
          <?xml version="1.0" encoding="utf-8"?>
          <adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
              <background android:drawable="@drawable/ic_launcher_background" />
              <foreground android:drawable="@drawable/ic_launcher_foreground" />
          </adaptive-icon>
          EOF_RES
          cat > "$R/mipmap-anydpi-v26/ic_launcher_round.xml" << 'EOF_RES'
          <?xml version="1.0" encoding="utf-8"?>
          <adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
              <background android:drawable="@drawable/ic_launcher_background" />
              <foreground android:drawable="@drawable/ic_launcher_foreground" />
          </adaptive-icon>
          EOF_RES
          cat > "$R/drawable/ic_launcher_background.xml" << 'EOF_RES'
          <?xml version="1.0" encoding="utf-8"?>
          <vector xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:aapt="http://schemas.android.com/aapt"
              android:width="108dp"
              android:height="108dp"
              android:viewportWidth="108"
              android:viewportHeight="108">

              <!-- Gradient w stylu Fluent: niebieski do fioletu -->
              <path android:pathData="M0,0h108v108h-108z">
                  <aapt:attr name="android:fillColor">
                      <gradient
                          android:type="linear"
                          android:startX="0"
                          android:startY="0"
                          android:endX="108"
                          android:endY="108">
                          <item android:offset="0" android:color="#FF0A6CD6" />
                          <item android:offset="0.55" android:color="#FF4F5BE8" />
                          <item android:offset="1" android:color="#FF8E4FDB" />
                      </gradient>
                  </aapt:attr>
              </path>

              <!-- Miękkie światło w lewym górnym rogu -->
              <path android:pathData="M0,0h108v108h-108z">
                  <aapt:attr name="android:fillColor">
                      <gradient
                          android:type="radial"
                          android:centerX="30"
                          android:centerY="22"
                          android:gradientRadius="80">
                          <item android:offset="0" android:color="#46FFFFFF" />
                          <item android:offset="1" android:color="#00FFFFFF" />
                      </gradient>
                  </aapt:attr>
              </path>

              <!-- Delikatne przyciemnienie prawego dołu -->
              <path android:pathData="M0,0h108v108h-108z">
                  <aapt:attr name="android:fillColor">
                      <gradient
                          android:type="radial"
                          android:centerX="103"
                          android:centerY="108"
                          android:gradientRadius="86">
                          <item android:offset="0" android:color="#46140A46" />
                          <item android:offset="1" android:color="#00140A46" />
                      </gradient>
                  </aapt:attr>
              </path>
          </vector>
          EOF_RES
          cat > "$R/drawable/ic_launcher_foreground.xml" << 'EOF_RES'
          <?xml version="1.0" encoding="utf-8"?>
          <vector xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:aapt="http://schemas.android.com/aapt"
              android:width="108dp"
              android:height="108dp"
              android:viewportWidth="108"
              android:viewportHeight="108">

              <!-- Miękki cień pod symbolem (dwie warstwy z przesunięciem) -->
              <path
                  android:pathData="M34.5,35.5L73.5,74.5M68.5,40.5L34.5,74.5"
                  android:strokeColor="#1A140A50"
                  android:strokeWidth="8.4"
                  android:strokeLineCap="round" />
              <path
                  android:pathData="M34.5,36.7L73.5,75.7M68.5,41.7L34.5,75.7"
                  android:strokeColor="#14140A50"
                  android:strokeWidth="9"
                  android:strokeLineCap="round" />

              <!-- Szklany dysk globu -->
              <path
                  android:fillColor="#2EFFFFFF"
                  android:pathData="M32,54a22,22 0 1,0 44,0a22,22 0 1,0 -44,0z" />

              <!-- Równik i południk -->
              <path
                  android:pathData="M32,54L76,54"
                  android:strokeColor="#5FFFFFFF"
                  android:strokeWidth="1.5" />
              <path
                  android:pathData="M43,54a11,22 0 1,0 22,0a11,22 0 1,0 -22,0z"
                  android:strokeColor="#5FFFFFFF"
                  android:strokeWidth="1.5" />

              <!-- Pierścień globu z wycięciem na iskrę -->
              <path
                  android:pathData="M77.4,45.94A24.75,24.75 0 1,1 62.06,30.6"
                  android:strokeColor="#78FFFFFF"
                  android:strokeWidth="5.5" />

              <!-- Kreska "\" -->
              <path
                  android:pathData="M34.5,34.5L73.5,73.5"
                  android:strokeWidth="7.4"
                  android:strokeLineCap="round">
                  <aapt:attr name="android:strokeColor">
                      <gradient
                          android:type="linear"
                          android:startX="34"
                          android:startY="34"
                          android:endX="74"
                          android:endY="74">
                          <item android:offset="0" android:color="#FFFFFFFF" />
                          <item android:offset="1" android:color="#FFC4E2FF" />
                      </gradient>
                  </aapt:attr>
              </path>

              <!-- Kreska "/" kończąca się iskrą -->
              <path
                  android:pathData="M68.5,39.5L34.5,73.5"
                  android:strokeWidth="7.4"
                  android:strokeLineCap="round">
                  <aapt:attr name="android:strokeColor">
                      <gradient
                          android:type="linear"
                          android:startX="68"
                          android:startY="40"
                          android:endX="34"
                          android:endY="74">
                          <item android:offset="0" android:color="#FFFFFFFF" />
                          <item android:offset="1" android:color="#FF6ED7FF" />
                      </gradient>
                  </aapt:attr>
              </path>

              <!-- Iskra (sztuczna inteligencja) -->
              <path android:pathData="M74.5,24Q74.5,33.5 84,33.5Q74.5,33.5 74.5,43Q74.5,33.5 65,33.5Q74.5,33.5 74.5,24z">
                  <aapt:attr name="android:fillColor">
                      <gradient
                          android:type="linear"
                          android:startX="70"
                          android:startY="24"
                          android:endX="84"
                          android:endY="43">
                          <item android:offset="0" android:color="#FFFFFFFF" />
                          <item android:offset="1" android:color="#FF96E1FF" />
                      </gradient>
                  </aapt:attr>
              </path>
          </vector>
          EOF_RES
          git config user.name "github-actions"
          git config user.email "github-actions@users.noreply.github.com"
          git add "$R"
          if git diff --cached --quiet; then
            echo "Pliki res już są, nic do dodania."
          else
            git commit -m "Dodaj folder res (motyw, teksty, backup, ikona AiXE)"
            git push
          fi
          gh workflow run android-build.yml --ref main || echo "Uruchom budowanie ręcznie: Actions, Android build, Run workflow."
